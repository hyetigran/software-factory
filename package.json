{
  "name": "@hyetigran/software-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Local requirements-to-approved-plan workflow",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests package.json tsconfig.json tsconfig.build.json eslint.config.js",
    "format:check": "prettier --check src tests package.json tsconfig.json tsconfig.build.json eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
